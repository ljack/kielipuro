{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kielipuro",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-01",
  "account_id": "2667f3483e660ef6937b37cc53f06d13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "GITHUB_REPOSITORY": "ljack/kielipuro" },
  "d1_databases": [
    { "binding": "DB", "database_name": "kielipuro-feedback", "database_id": "75550043-6308-4cad-be51-1f40e3f64ee9", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true }
}
